def proofRow006 (i : Fin rows006.length) : PreparedRow :=
  prepare (rows006.get i) (normRoots006.getD i.val ⟨0,0⟩)

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem proofRows006_numeric : ∀ i : Fin rows006.length,
    (proofRow006 i).NumericValid ∧ (proofRow006 i).Matches meta ∧
    (rows006.get i).Structural meta := by
  decide

theorem rows006_claims : ∀ r ∈ rows006, r.Claim meta := by
  intro r hr
  obtain ⟨i,rfl⟩ := List.mem_iff_get.mp hr
  exact PreparedRow.claim (proofRows006_numeric i).1 (proofRows006_numeric i).2.1

theorem rows006_structural : ∀ r ∈ rows006, r.Structural meta := by
  intro r hr
