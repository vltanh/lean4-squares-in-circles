theorem proofRows030_numeric : ∀ i : Fin rows030.length,
    (proofRow030 i).NumericValid ∧ (proofRow030 i).Matches meta ∧
    (rows030.get i).Structural meta := by
  decide

theorem rows030_claims : ∀ r ∈ rows030, r.Claim meta := by
  intro r hr
  obtain ⟨i,rfl⟩ := List.mem_iff_get.mp hr
  exact PreparedRow.claim (proofRows030_numeric i).1 (proofRows030_numeric i).2.1

theorem rows030_structural : ∀ r ∈ rows030, r.Structural meta := by
  intro r hr
  obtain ⟨i,rfl⟩ := List.mem_iff_get.mp hr
  exact (proofRows030_numeric i).2.2

