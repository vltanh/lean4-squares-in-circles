  .outside (by norm_num [b3, b2, b1, b0, rootBox, RationalBox.lowerLeft, RationalBox.lowerRight, RationalBox.upperLeft, RationalBox.upperRight, RationalBox.minimumNormSq, lowerSquare])

private def c2 : CoverCertificate referenceWitness b2 :=
  .split c3 c4 c17 c18

private def c1 : CoverCertificate referenceWitness b1 :=
  .split c2 c23 c24 c29

private def c0 : CoverCertificate referenceWitness b0 :=
  .split c1 c46 c75 c104

def certificate : CoverCertificate referenceWitness rootBox := c0

/-- The concrete certificate supplies the full cover hypothesis. -/
theorem no_four_remaining_centers (extra : Fin 4 → Point)
    (hnorm : ∀ i, sqdist (extra i) (0, 0) < ((91 : ℝ) / 60) ^ 2)
    (hseparated : ∀ i j, i ≠ j → 1 ≤ sqdist (extra i) (extra j))
    (hfar : ∀ i w, (529 : ℝ) / 2500 ≤ sqdist (extra i) (referenceWitness w)) : False := by
  apply no_four_centers_in_east_south extra hseparated
  intro i
  exact certificate.sound (extra i) (mem_rootBox (extra i) (hnorm i)) (hnorm i) (hfar i)

theorem grid_weight_bounds (i : Fin 9) :
    0 ≤ (i.val : ℝ) / 8 ∧ (i.val : ℝ) / 8 ≤ 1 := by
  have hn : i.val ≤ 8 := by omega
  have hr : (i.val : ℝ) ≤ 8 := by exact_mod_cast hn
  constructor
  · positivity
  · linarith

theorem reference_witness_error (actual : Fin 5 → Fin 4 → Point)
    (hvertex : ∀ k v, sqdist (referenceVertices k v) (actual k v) ≤ (1 : ℝ) / 625)
    (i : WitnessIndex) : sqdist (referenceWitness i) (actualWitness actual i) ≤ (1 : ℝ) / 625 := by
  rcases grid_weight_bounds i.u with ⟨hu0, hu1⟩
  rcases grid_weight_bounds i.v with ⟨hv0, hv1⟩
  exact witness_error_bound (referenceVertices i.core) (actual i.core)
    ((i.u.val : ℝ) / 8) ((i.v.val : ℝ) / 8) ((1 : ℝ) / 625)
    hu0 hu1 hv0 hv1 (hvertex i.core)

/-- Complete exact conditional five-core exclusion. Actual witness membership
in the five squares and its 1/2 separation from an extra's center are the
geometric caller's responsibility. No abstract box-cover hypothesis remains. -/
theorem no_four_from_vertex_neighborhood (actual : Fin 5 → Fin 4 → Point)
    (extra : Fin 4 → Point)
    (hvertex : ∀ k v, sqdist (referenceVertices k v) (actual k v) ≤ (1 : ℝ) / 625)
    (hnorm : ∀ i, sqdist (extra i) (0, 0) < ((91 : ℝ) / 60) ^ 2)
    (hseparated : ∀ i j, i ≠ j → 1 ≤ sqdist (extra i) (extra j))
    (havoid : ∀ i w, (1 : ℝ) / 4 ≤ sqdist (extra i) (actualWitness actual w)) : False := by
  apply no_four_remaining_centers extra hnorm hseparated
  intro i w
  by_contra h
  have hnear : sqdist (extra i) (referenceWitness w) < (529 : ℝ) / 2500 := lt_of_not_ge h
  have hactual := robust_half_ball_witness (extra i) (referenceWitness w)
    (actualWitness actual w) hnear (reference_witness_error actual hvertex w)
  have hlarge := havoid i w
  linarith

#print axioms certificate
#print axioms no_four_from_vertex_neighborhood

end SquaresInCircles.Nine.FiveCoreCapacityDraft
